{
	"name": "pi-story-project",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"check": "node scripts/check-upstream.mjs && node scripts/check-deps.mjs && node scripts/check-datasets.mjs && biome check --error-on-warnings . && tsc --noEmit",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:upstream": "node --test test/check-upstream.test.mjs",
		"test:deps": "node --test test/check-deps.test.mjs",
		"eval:p1": "node scripts/eval/run-suite.mjs --all",
		"install:isolated": "node scripts/install-isolated.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
