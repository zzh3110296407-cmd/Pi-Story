    "reproducerSource": "import assert from 'node:assert/strict';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport path from 'node:path';\nimport {foldBranch,stateAt} from 'file:///D:/AI/Story%20Dome/Story/pi-Story/story/packages/core/src/fold/index.ts';\nimport {schemas,validate} from 'file:///D:/AI/Story%20Dome/Story/pi-Story/story/packages/core/src/schema/index.ts';\nimport {editorInput,keeperInput} from 'file:///D:/AI/Story%20Dome/Story/pi-Story/story/packages/core/src/flow/inputs.ts';\nimport {numberedLines,sentences,digest} from 'file:///D:/AI/Story%20Dome/Story/pi-Story/story/packages/core/src/shared/text.ts';\nconst root='D:/AI/Story Dome/Story/pi-Story/story/testing/datasets/DS12-context-cases/v1';\nconst review=JSON.parse(readFileSync('D:/AI/Story Dome/新版综合方案/测试结果/P2/人工复核/DS12-v1-抽查.json','utf8'));\nconst hasField=(v,name)=>v&&typeof v==='object'&&(Object.hasOwn(v,name)||Object.values(v).some(x=>hasField(x,name)));\nconst hasPath=(v,p)=>p.slice(2).split('.').every(k=>{if(v===null||typeof v!=='object'||!Object.hasOwn(v,k))return false;v=v[k];return true;});\nconst predicate=(v,p)=>p.type==='json_path_exists'?hasPath(v,p.value):p.type==='field_absent'?!hasField(v,p.value):p.type==='text_contains'?JSON.stringify(v).includes(p.value):p.type==='text_absent'?!JSON.stringify(v).includes(p.value):false;\nconst results=[];let detailsChecked=0;\nfor(const item of review.items){const c=JSON.parse(readFileSync(path.join(root,'acceptance',item.itemId+'.json'),'utf8'));for(const e of c.entries){const d=e.details??e.data;if(!d)continue;const name=Object.keys(schemas).find(k=>schemas[k].properties?.schema?.const===d.schema);assert(name);const r=validate(schemas[name],d);assert(r.ok,JSON.stringify(r.errors));detailsChecked++;}const m=foldBranch(c.entries),draft=m.drafts.at(-1);assert.equal(m.lastChapter,1);assert.equal(draft.chapter,c.chapter);assert.equal(draft.digest,digest(draft.text));const obs=c.entries.find(e=>e.details?.schema==='story/review@1').details.observations;const scope={spans:[{start:1,end:1}],forObservations:obs.map(o=>o.id)};const input=c.role==='keeper'?keeperInput(m,draft):editorInput(m,draft,c.role==='recheck'?scope:'full',c.role==='recheck'?obs:[]);const checks=[...c.must.map(p=>({group:'must',...p,passed:predicate(input,p)})),...c.forbidden.map(p=>({group:'forbidden',...p,passed:predicate(input,p)}))];assert(checks.every(p=>p.passed),JSON.stringify({id:c.id,checks}));const detail={id:c.id,role:c.role,must:c.must.length,forbidden:c.forbidden.length,checks,roleInputKeys:Object.keys(input),input};if(c.role==='keeper'){const fact=stateAt(m).facts.find(f=>f.id==='F-1');assert.equal(fact.subject,'item:brass_key');assert.equal(fact.predicate,'holder');assert.equal(fact.object,'char:nolan');const ss=sentences(draft.text,2,'s2');assert.equal(ss[0].id,'c02.s0001');assert.equal(ss[0].text,'Nolan laid the brass key on the mantel.');detail.verifiedCurrentFact=fact;detail.firstSentence=input.sentences[0];if(c.id.includes('edited-ledger')){assert.equal(m.ledger[0].text,'If the bell rings again, Ada must wait beside the blue door.');assert.equal(m.ledger[0].authorEditEntryId,'author-ledger-edit');assert.equal(m.ledger[0].sourceSpans.length,0);detail.editedLedgerState={text:m.ledger[0].text,authorEditEntryId:m.ledger[0].authorEditEntryId,sourceSpans:m.ledger[0].sourceSpans};}}else{assert.deepEqual(input.draft.lines,numberedLines(draft.text));assert.equal(input.intent.chapter,2);detail.numberedDraft=input.draft.lines;detail.futureBibleEntry={effectiveFromChapter:m.bible['place:future_vault'].effectiveFromChapter,excluded:!JSON.stringify(input).includes('SK_TEST_P2_CANARY_FUTURE_1111111111111111')};if(c.role==='recheck'){assert.equal(input.observations[0].id,'c02-r01-o01');assert.equal(input.observations[0].impact,obs[0].impact);assert.deepEqual(input.observations[0].evidence,obs[0].evidence);assert.deepEqual(input.scope,scope);}}results.push(detail);}\nconst report={cases:5,detailsChecked,passedPredicates:results.flatMap(r=>r.checks).filter(p=>p.passed).length,totalPredicates:results.flatMap(r=>r.checks).length,results,modelRequests:0};writeFileSync('D:/开源/test/pi-Story/p2/temp/ds12-sample-review-result.json',JSON.stringify(report,null,2)+'\\n');console.log(JSON.stringify({cases:report.cases,detailsChecked,passed:report.passedPredicates,total:report.totalPredicates,results:results.map(r=>({id:r.id,must:r.must,forbidden:r.forbidden,passed:true})),modelRequests:0}));\n",
