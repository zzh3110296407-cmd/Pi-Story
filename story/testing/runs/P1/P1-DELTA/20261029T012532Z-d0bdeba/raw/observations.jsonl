{"kind":"delta","data":{"id":"D10-leak-1","group":"violation","rule":"D10","layer":"keeper_input","matched":true,"input":{"task":"settle","chapter":2,"sentences":[{"n":1,"ref":"c02.s0001","text":"林遥把铜钥匙交给店主。"},{"n":2,"ref":"c02.s0002","text":"店主把钥匙放进木盒。"},{"n":3,"ref":"c02.s0003","text":"店主熄灭油灯。"},{"n":4,"ref":"c02.s0004","text":"林遥走到河岸。"},{"n":5,"ref":"c02.s0005","text":"林遥收到两枚银币。"},{"n":6,"ref":"c02.s0006","text":"林遥付出三枚银币。"},{"n":7,"ref":"c02.s0007","text":"天边的云渐渐散开。"},{"n":8,"ref":"c02.s0008","text":"“钥匙在河底。”"},{"n":9,"ref":"c02.s0009","text":"「店主已经死了。」"},{"n":10,"ref":"c02.s0010","text":"『那本日志已经烧毁。』"},{"n":11,"ref":"c02.s0011","text":"店主告诉林遥钟声意味着渡口关闭。"},{"n":12,"ref":"c02.s0012","text":"林遥读懂了日志上的暗号。"},{"n":13,"ref":"c02.s0013","text":"店主开始怀疑陌生人的身份。"},{"n":14,"ref":"c02.s0014","text":"林遥发现陌生人就是父亲的旧友。"},{"n":15,"ref":"c02.s0015","text":"店主仍然活着。"},{"n":16,"ref":"c02.s0016","text":"林遥仔细检查了手里的纸条。"},{"n":17,"ref":"c02.s0017","text":"林遥摸到钥匙上的铜锈，确认它是铜制的。"},{"n":18,"ref":"c02.s0018","text":"店主承认自己信任林遥。"},{"n":19,"ref":"c02.s0019","text":"林遥终于确信店主值得信任。"},{"n":20,"ref":"c02.s0020","text":"林遥意识到钟声就是航路暗号。"},{"n":21,"ref":"c02.s0021","text":"日志背面的纸条揭开了钟声之谜。"},{"n":22,"ref":"c02.s0022","text":"他们暂时搁置追查蓝线来历。"},{"n":23,"ref":"c02.s0023","text":"墙上又出现一枚蓝色结。"},{"n":24,"ref":"c02.s0024","text":"一本新账册给出了另一条追查方向。"},{"n":25,"ref":"c02.s0025","text":"林遥决定明天才出发。"},{"n":26,"ref":"c02.s0026","text":"如果河水上涨，渡船就不能通行。"},{"n":27,"ref":"c02.s0027","text":"林遥梦见父亲回到了书店。"},{"n":28,"ref":"c02.s0028","text":"林遥想起去年自己住在山城。"},{"n":29,"ref":"c02.s0029","text":"林遥想起父亲早已去世。"},{"n":30,"ref":"c02.s0030","text":"旧日的店主其实是一名画师。"},{"n":31,"ref":"c02.s0031","text":"银币袋里现在有十二枚银币。"},{"n":32,"ref":"c02.s0032","text":"林遥把一本旧书送给陌生人。"},{"n":33,"ref":"c02.s0033","text":"箱底出现一枚陌生的印章。"},{"n":34,"ref":"c02.s0034","text":"店主从书店走到河岸。"},{"n":35,"ref":"c02.s0035","text":"林遥不再相信那封假信。"},{"n":36,"ref":"c02.s0036","text":"店主改口说陌生人值得信任。"}],"state":{"asOfChapter":1,"facts":[{"id":"F-1","subject":"char:lin_yao","predicate":"locat