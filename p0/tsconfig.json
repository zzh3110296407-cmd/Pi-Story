{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["ext/**/*.ts", "rpc/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["fixtures", "node_modules", "web-smoke"]
}
